

<div class="antialiased font-sans bg-gray-200 w-full">
  <div class="container mx-auto px-4 sm:px-8">
    <div class="py-8">
      <%= link_to "Back", view_v1_hubspot_actions_path %>
      <br/>
      <br/>
      <br/>
      <div>
        <h2 class="text-2xl font-semibold leading-tight">Action Details</h2>
      </div>
      <br/>
      <div class="inline-block min-w-full shadow rounded-lg overflow-hidden">
        <table class="min-w-full leading-normal">
          <thead>
            <tr>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                ID
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Action Type
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Status
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Service Type
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Synced At
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Created At
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Last Update At
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Updated
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= @action.id %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= @action.action_type.titleize %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                <span class="inline-block px-2 py-1 text-xs font-semibold text-white rounded-full <%= status_color_class(@action.status) %>">
                  <%= @action.status.capitalize %>
                </span>
              </td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= @action.body['service_type'] || '-' %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= @action.synced_at.present? ? (@action.synced_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') : '-' %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= (@action.created_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= (@action.updated_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') %></td>
              <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= @action.updated? ? 'Yes' : 'No' %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <br/>
      <br/>
      <div>
        <h2 class="text-2xl font-semibold leading-tight">Body Details</h2>
      </div>
      <br/>
      <div class="inline-block min-w-full shadow rounded-lg overflow-hidden">
        <table class="min-w-full leading-normal">
          <thead>
            <tr>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Attribute
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Value
              </th>
            </tr>
          </thead>
          <tbody>
            <% @action.body.each do |key, value| %>
              <% next if key == 'service_type' %>
              <tr>
                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= key.titleize %></td>
                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= value %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <br/>
      <br/>
      <div>
        <h2 class="text-2xl font-semibold leading-tight">HubSpot synced data</h2>
      </div>
      <br/>
      <div class="inline-block min-w-full shadow rounded-lg overflow-hidden">
        <table class="min-w-full leading-normal">
          <thead>
            <tr>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Attribute
              </th>
              <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                Value
              </th>
            </tr>
          </thead>
          <tbody>
            <% @action.metadata.to_h['additional_data'].to_a.each do |key, value| %>
              <% if key == 'id'  %>
                <% key = 'darah DB Id' %>
              <% end %>
              <tr>
                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= key.titleize %></td>
                <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= value %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>