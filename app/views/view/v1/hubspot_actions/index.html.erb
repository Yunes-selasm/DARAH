<div class="antialiased font-sans bg-gray-200 w-full">
<%= button_to 'Logout', logout_path, method: :delete, class: "text-red-500 font-medium", form: { class: "inline" } %>
  <div class="container mx-auto px-4 sm:px-8">
    <div class="py-8">
      <div>
        <h2 class="text-2xl font-semibold leading-tight">HubSpot Actions (Beta)</h2>
      </div>

      <!-- Search + Filter Form -->
      <%= search_form_for @q, url: view_v1_hubspot_actions_path, method: :get, html: { class: "my-4 flex flex-wrap gap-4" } do |f| %>
        <div class="relative">
          <input type="text"
                 name="q[id_or_status_or_action_type_cont]"
                 placeholder="Search by ID"
                 value="<%= params.dig(:q, :id_or_status_or_action_type_cont) %>"
                 class="appearance-none rounded border border-gray-400 py-2 px-4 w-20 bg-white text-sm placeholder-gray-400 text-gray-700 focus:outline-none focus:border-blue-500" />
        </div>

        <div class="relative">
          <%= f.select :status_eq, statuses_dropdown, { include_blank: "All Statuses" },
              class: "appearance-none rounded border border-gray-400 py-2 px-4 bg-white text-sm text-gray-700 focus:outline-none focus:border-blue-500" %>
        </div>

        <div class="relative">
          <%= f.select :action_type_eq, action_types_dropdown, { include_blank: "All Types" },
              class: "appearance-none rounded border border-gray-400 py-2 px-4 bg-white text-sm text-gray-700 focus:outline-none focus:border-blue-500" %>
        </div>

        <div class="relative">
          <%= f.label :created_at_date_gteq, "From", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :created_at_date_gteq, value: params.dig(:q, :created_at_date_gteq), 
                class: "appearance-none rounded border border-gray-400 py-2 px-4 w-44 bg-white text-sm text-gray-700 focus:outline-none focus:border-blue-500" %>
        </div>

        <div class="relative">
          <%= f.label :created_at_date_lteq, "To", class: "block text-sm font-medium text-gray-700" %>
          <%= f.date_field :created_at_date_lteq, value: params.dig(:q, :created_at_date_lteq),
                class: "appearance-none rounded border border-gray-400 py-2 px-4 w-44 bg-white text-sm text-gray-700 focus:outline-none focus:border-blue-500" %>
        </div>

        <div>
          <%= f.submit "Search", class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded" %>
        </div>

        <div class="relative">
          <%= link_to "Clear Filters", view_v1_hubspot_actions_path,
          class: "bg-gray-300 hover:bg-gray-400 text-gray-800 font-semibold py-2 px-4 rounded ml-2" %>
        </div>
      <% end %>

      <!-- Actions Table -->
      <div class="-mx-4 sm:-mx-8 px-4 sm:px-8 py-4 overflow-x-auto">
        <div class="inline-block min-w-full shadow rounded-lg overflow-hidden">
          <table class="min-w-full leading-normal">
            <thead>
              <tr>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  ID
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Action Type
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Status
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Added By Darah
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Created At
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Last Update At
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Updated
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Synced At
                </th>
                <th class="px-5 py-3 border-b-2 border-gray-200 bg-gray-100 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody>
              <% @actions.each do |action| %>
                <tr>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= action.id %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= action.action_type.titleize %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                    <span class="inline-block px-2 py-1 text-xs font-semibold text-white rounded-full <%= status_color_class(action.status.titleize) %>">
                      <%= action.status.capitalize %>
                    </span>
                  </td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= action.body['is_added_by_darah'] == true ? 'Yes' : 'No' %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= (action.created_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= (action.updated_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= action.updated? ? 'Yes' : 'No' %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm"><%= action.synced_at.present? ? (action.synced_at + 3.hours).strftime('%Y-%m-%d %I:%M %p') : '-' %></td>
                  <td class="px-5 py-5 border-b border-gray-200 bg-white text-sm">
                    <%= link_to "Details", view_v1_hubspot_action_path(action.id) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <!-- Pagination -->
          <div class="px-5 py-5 bg-white border-t flex flex-col sm:flex-row items-center justify-between">
            <span class="text-xs text-gray-900">
              Showing <%= @actions.offset_value + 1 %> to <%= [@actions.offset_value + @actions.limit_value, @actions.total_count].min %> of <%= @actions.total_count %> entries
            </span>
            <div class="mt-2 sm:mt-0">
              <%= 
                paginate @actions, params: { q: params[:q] }
              %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
